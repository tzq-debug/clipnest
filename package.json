{
  "name": "clipnest",
  "productName": "ClipNest",
  "version": "0.2.0",
  "private": true,
  "description": "Clipboard history with multi-select batch paste. Edge-docked, always one keystroke away.",
  "license": "MIT",
  "author": "ClipNest contributors",
  "homepage": "https://github.com/your-name/clipnest",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "preview": "vite build && electron scripts/preview.cjs list",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
