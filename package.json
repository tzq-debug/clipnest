{
  "name": "clipnest",
  "productName": "ClipNest",
  "version": "0.8.0",
  "private": true,
  "description": "Clipboard history with multi-select batch paste. Edge-docked, always one keystroke away.",
  "license": "MIT",
  "author": "ClipNest contributors",
  "homepage": "https://github.com/tzq-debug/clipnest",
  "repository": {
    "type": "git",
    "url": "https://github.com/tzq-debug/clipnest.git"
  },
  "bugs": {
    "url": "https://github.com/tzq-debug/clipnest/issues"
  },
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "clipboard-history",
    "paste",
    "electron",
    "desktop",
    "productivity"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node scripts/probe-export.cjs && node scripts/probe-drag.cjs && npm run test:app",
    "test:app": "electron scripts/probe-vault.cjs && electron scripts/probe-sensitive.cjs && electron scripts/probe-seal.cjs",
    "start": "npm run build && electron .",
    "preview": "vite build && electron scripts/preview.cjs list",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
